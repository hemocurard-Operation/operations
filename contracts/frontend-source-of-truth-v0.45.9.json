    {"path":"command-center.js","canonical":"hemocura-core/command-center.js","blob_sha":"a9cb798474b48920b64f9280201bb51e5b919186"}
  ],
  "rules": [
    "New application modules belong under hemocura-core, not repository root.",
    "Root-level legacy modules may only be removed after exact-content/reference checks and CI validation.",
    "The runtime entry chain must not be redirected to a legacy root module.",
    "js/config.js remains a protected environment file and is not duplicated into hemocura-core.",
    "The root shadow count may decrease but must not increase above the current budget."
  ]
